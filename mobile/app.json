{
  "expo": {
    "name": "PlatIO",
    "slug": "platio",
    "version": "0.7.0",
    "orientation": "portrait",
    "scheme": "platio",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.platio.app"
    },
    "ios": {
      "bundleIdentifier": "com.platio.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "PlatIO usa tu red local para vincular la central y leer tus plantas.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "plant-care"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "PlatIO usa Bluetooth para encontrar y configurar tu central."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
