{
  "expo": {
    "name": "PlatIO",
    "slug": "platio",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.platio.mobile"
    },
    "android": {
      "package": "app.platio.mobile"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "PlatIO usa la cámara para escanear el QR de tu central.",
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "plantas"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
